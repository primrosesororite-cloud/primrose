# URL publique du site (SEO : sitemap, Open Graph, hreflang)
NEXT_PUBLIC_SITE_URL=https://sororiteprimrose.org

# Supabase (voir Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (anti-spam formulaires publics)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Chiffrement applicatif des champs sensibles de demandes_aide (coordonnée, message).
# Obligatoire en production : sans elle, le formulaire /besoin-d-aide refuse les envois.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEMANDES_AIDE_ENCRYPTION_KEY=

# Resend (notification e-mail à l'équipe pour toute demande d'aide URGENTE).
# Sans ces variables, la notification est simplement ignorée (le formulaire
# fonctionne quand même) — à configurer avant mise en production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=alertes@sororiteprimrose.org
ASSOCIATION_ALERT_EMAIL=

# Plausible (mesure d'audience sans cookie). Facultatif : sans cette variable,
# aucune bannière ne s'affiche et rien n'est chargé — le site reste sans
# aucun tracking par défaut. Toujours exclu de /besoin-d-aide.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
